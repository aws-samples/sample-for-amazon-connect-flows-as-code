# Connect Flow Export Module - S3 Bucket Configuration

resource "random_id" "bucket_suffix" {
  byte_length = 4
}

locals {
  s3_bucket_name   = var.s3_bucket_name != null ? var.s3_bucket_name : "connect-flow-export-${random_id.bucket_suffix.hex}"
  s3_object_prefix = var.s3_key_prefix != "" ? "${var.s3_key_prefix}/*" : "*"
}

# The bucket holds exported flow templates: JSON with no ARNs, no credentials and
# no contact data, in an account the reader owns. The suppressions inside each
# carry their reason.
resource "aws_s3_bucket" "export" {
  # Appropriate for a sample, and NOT what you would do in production.
  #
  # Without this, `terraform destroy` fails with BucketNotEmpty and the reader
  # has to empty a VERSIONED bucket by hand — deleting every version and delete
  # marker, not just the current objects. Testing the documented teardown showed
  # that trap has teeth: the first destroy attempt fails part-way, and by then it
  # has already removed the resources the outputs depend on, so
  # `terraform output -raw export_bucket` no longer resolves and the reader
  # cannot get the bucket name they need to unblock it.
  #
  # The contents are exported flow templates, regenerated by re-running the
  # exporter, so nothing here is worth protecting at the cost of leaving billable
  # resources behind in a reader's account.
  force_destroy = true

  #checkov:skip=CKV_AWS_18:Access logging needs a second bucket to receive the logs, doubling the sample's storage footprint to audit reads of non-sensitive templates the reader wrote themselves.
  #checkov:skip=CKV_AWS_144:Cross-region replication is disproportionate for a sample whose contents are regenerated by re-running the exporter.
  #checkov:skip=CKV_AWS_145:SSE-S3 (AES256) is configured rather than SSE-KMS. A customer-managed key carries a monthly charge and per-request costs for no confidentiality gain on non-sensitive content.
  #checkov:skip=CKV2_AWS_62:Event notifications have no consumer here. The pipeline is CloudTrail -> EventBridge -> Lambda -> S3; nothing reacts to the write.
  bucket = local.s3_bucket_name
  tags   = merge(var.tags, { Name = local.s3_bucket_name })
}

resource "aws_s3_bucket_versioning" "export" {
  bucket = aws_s3_bucket.export.id
  versioning_configuration { status = "Enabled" }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "export" {
  bucket = aws_s3_bucket.export.id
  rule {
    apply_server_side_encryption_by_default { sse_algorithm = "AES256" }
  }
}

resource "aws_s3_bucket_public_access_block" "export" {
  bucket                  = aws_s3_bucket.export.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_lifecycle_configuration" "export" {
  bucket = aws_s3_bucket.export.id

  rule {
    id     = "expire-old-exports"
    status = "Enabled"

    filter {
      prefix = var.s3_key_prefix
    }

    expiration {
      days = 30
    }

    noncurrent_version_expiration {
      noncurrent_days = 7
    }
  }

  # Separate, deliberately UNFILTERED rule. Attaching this to the rule above
  # would only abort uploads under var.s3_key_prefix, leaving orphaned parts
  # anywhere else in the bucket billed but invisible in the console.
  rule {
    id     = "abort-incomplete-uploads"
    status = "Enabled"

    filter {}

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}

# Terraform working directories and state.
# State is local on purpose in this demo (see 01-source/versions.tf), which makes
# it all the more important never to commit it: it carries instance IDs, bucket
# names and the random alias suffix.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Real variable values. Commit only terraform.tfvars.example.
terraform.tfvars
*.auto.tfvars

# Lambda build output: generated by `terraform apply` from lambda/exporter/**.
modules/flow-exporter/.build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Templates the reader copies out of the export bucket during the walkthrough.
# Left untracked so a fresh clone starts empty and step 5 has something to do —
# and so nobody accidentally commits templates carrying another account's names.
02-target/flows/*.json.tpl
02-target/flow-modules/*.json.tpl

.DS_Store
